{
    "name": "nodes/core",
    "description": "Required for all Nodes packages",
    "keywords": [
        "nodes",
        "core",
        "helpers",
        "tools",
        "laravel"
    ],
    "license": "MIT",
    "homepage": "http://nodesagency.com",
    "authors": [
        {
            "name": "Casper Rasmussen",
            "email": "cr@nodes.dk",
            "role": "CTO"
        }
    ],
    "require": {
        "laravel/framework": "^11.0",
        "illuminate/support": "^11.0",
        "symfony/http-kernel": "^7.0",
        "browscap/browscap-php": "^7.1",
        "illuminate/console": "^11.0",
        "illuminate/filesystem": "^11.0",
        "league/flysystem": "^3.14",
        "doctrine/common": "^3.4",
        "doctrine/cache": "1.13.0",
        "roave/doctrine-simplecache": "^2.7"
    },
    "autoload": {
        "psr-4": {
           "Nodes\\": "src/"
        },
        "files": [
            "src/Support/Helpers/Config.php",
            "src/Support/Helpers/Filesystem.php",
            "src/Support/Helpers/Install.php",
            "src/Support/Helpers/Request.php",
            "src/Support/Helpers/String.php",
            "src/Support/Helpers/UserAgent.php"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "repositories": [{
        "type": "vcs",
        "url": "https://github.com/jamesforddesign/nodes-validation"
    }]
}
